{
  "name": "security-cheat-sheets",
  "private": true,
  "type": "module",
  "description": "Opinionated, dated security cheat sheets with web, PDF and Markdown output",
  "scripts": {
    "build": "node src/build.mjs",
    "build:html": "node src/build.mjs --no-pdf",
    "check": "node src/build.mjs --strict",
    "serve": "node src/serve.mjs",
    "dev": "node src/build.mjs --no-pdf && node src/serve.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  }
}
